# Dev settings for deploy/compose.yaml with the overlay tools/dev/compose.yaml
# (--env-file tools/dev/dev.env). Fixture values only. Paths are relative to
# deploy/, the compose project directory.
RECAP_IMAGE=localhost/recap:dev
RECAP_CONFIG_DIR=../tools/dev/config
# Created by tools/dev/dev-secrets.sh (gitignored).
RECAP_SECRETS_DIR=../tools/dev/secrets
RECAP_FRONTEND_SERVERS=pilos-fixture:bbb-fixture-a
# S3 on the dev MinIO (the compose default is fs).
RECAP_BLOB_BACKEND=s3
RECAP_S3_ENDPOINT=http://minio:9000
RECAP_S3_BUCKET=recap
# Admin UI against the mock OIDC provider: the api reaches the issuer inside
# the compose network, the browser logs in on the published mock port and
# comes back to RECAP_PUBLIC_BASE_URL.
RECAP_PUBLIC_BASE_URL=http://127.0.0.1:8080
RECAP_OIDC_ISSUER=http://mock:8080/oidc
RECAP_OIDC_CLIENT_ID=recap-admin-ui
RECAP_MOCK_OIDC_BROWSER_URL=http://127.0.0.1:8081/oidc
