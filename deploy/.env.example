# Settings for compose.yaml. Copy to .env next to it and edit.
# Empty or commented out means the default shown. Reference: docs/reference/deployment.md §5.
# Secrets never go here: they are files in ./secrets (docs/operations/install-compose.md).
# Not settable here (fixed by compose.yaml and the image): the *_FILE paths, RECAP_FS_ROOT,
# RECAP_PROVIDERS_FILE, RECAP_SINKS_FILE, RECAP_MEETING_TYPES_FILE, RECAP_FORMATS_DIR, RECAP_CLIENT_SECRETS_DIR.

# --- Required

# The image to run: a release tag from ghcr.io (docs/operations/release.md).
RECAP_IMAGE=ghcr.io/virtuos/bbb-recap/recap:v0.1.0

# --- Admin UI (off while RECAP_OIDC_ISSUER is empty)

# Public URL of this service; the login redirect is <url>/admin/callback.
RECAP_PUBLIC_BASE_URL=
# OIDC issuer URL, e.g. https://keycloak.example.org/realms/example. Setting it turns the admin UI on.
RECAP_OIDC_ISSUER=
# OIDC client ID; its secret is secrets/oidc-client-secret, the session key secrets/session-key.
RECAP_OIDC_CLIENT_ID=
# Top-level string-list claim that must contain recap-admin (default roles).
RECAP_OIDC_ROLE_CLAIM=

# --- Front ends

# Limit the BBB servers a front end may claim recordings of: <frontend_id>:<bbb_server_id>,... (default: all).
# Set it only when several organisations share this service, e.g. pilos-a:bbb-a,moodle-b:bbb-b.
RECAP_FRONTEND_SERVERS=
# Limit the meeting types a front end may request: <frontend_id>:<meeting type>,... (default: all).
RECAP_FRONTEND_TYPES=
# Limit the sink profiles a front end may request: <frontend_id>:<sink profile>,... (default: all).
RECAP_FRONTEND_SINKS=
# Prefix of the meta keys the front end sets on BBB create; must match the exporter (default recap).
RECAP_META_PREFIX=

# --- Retention (docs/reference/privacy.md §4; the defaults are the privacy-friendly ones)

# Delay before meeting content is deleted after delivery (default 0: right away).
RECAP_RETENTION_AFTER_DELIVERY=
# How long the result waits for the front end after delivery (default 7d; above 0 for a frontend sink).
RECAP_RESULT_TTL=
# Unmatched registrations are deleted after (default 14d).
RECAP_REGISTRATION_TTL=
# Unfinished uploads are deleted after (default 72h).
RECAP_INGEST_STAGING_TTL=
# Pseudonymous job rows are deleted after (default 180d).
RECAP_JOB_METADATA_RETENTION=

# --- Output

# IANA time zone for dates in titles and documents (default UTC).
RECAP_DISPLAY_TZ=
# Output language when the transcript has none, ISO 639-1 (default en).
RECAP_DEFAULT_LANGUAGE=
# Force the speech recognition language, ISO 639-1 (default: detect per speaker).
RECAP_ASR_LANGUAGE=

# --- Database and files

# External Postgres instead of the bundled one, without password (that is secrets/db-password):
# postgres://recap@db.example.org:5432/recap?sslmode=verify-full
RECAP_DB_DSN=
# Where meeting files are kept while a job runs: fs (volume blobdata, default) or s3.
RECAP_BLOB_BACKEND=
# Only with s3: endpoint (https://), bucket (create it once, versioning off), region (default us-east-1).
# Keys: secrets/s3-access-key-id, secrets/s3-secret-access-key.
RECAP_S3_ENDPOINT=
RECAP_S3_BUCKET=
RECAP_S3_REGION=

# --- Host

# Host port of the api, bound to 127.0.0.1 for the reverse proxy (default 8080).
RECAP_HTTP_PORT=
# Directories with the config files and the secrets (default ./config and ./secrets).
RECAP_CONFIG_DIR=
RECAP_SECRETS_DIR=

# --- Operation

# debug, info, warn or error (default info). No meeting content is logged at any level.
RECAP_LOG_LEVEL=
# Steps run at once per worker (default 4).
RECAP_WORKER_SLOTS=
