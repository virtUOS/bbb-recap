# /etc/recap-exporter/exporter.env: settings of the recap-exporter daemon and the post_archive hook.
# One KEY=value per line, no quotes, no spaces around =, no shell expansion. Empty means the default.
# Only RECAP_EXPORTER_* keys; any other key stops the daemon. No secrets here.
# Reference: docs/reference/deployment.md §5.4.

# Required: the service URL (https:// only) and this server's ID (bbb_server.<id> on the service).
RECAP_EXPORTER_SERVICE_URL=https://recap.example.org
RECAP_EXPORTER_BBB_SERVER_ID=bbb-1

# Ingest token file, mode 0400, owner recap-exporter.
# RECAP_EXPORTER_TOKEN_FILE=/etc/recap-exporter/secrets/ingest-token
# Must equal RECAP_META_PREFIX of the service.
# RECAP_EXPORTER_META_PREFIX=recap

# Paths as the hook sees them (keep the defaults).
# RECAP_EXPORTER_RAW_DIR=/var/bigbluebutton/recording/raw
# RECAP_EXPORTER_SPOOL_DIR=/var/lib/recap-exporter/spool
# RECAP_EXPORTER_STATE_DIR=/var/lib/recap-exporter/state

# Delete raw data: never (default) or after_ack. Failure expiry in days, 0 = off.
# RECAP_EXPORTER_DELETE_POLICY=never
# RECAP_EXPORTER_DELETE_AFTER_FAILURE_DAYS=0
# Needed for deletion: BBB's status dir and the formats that must be published first.
# RECAP_EXPORTER_RECORDING_STATUS_DIR=/var/bigbluebutton/recording/status
# RECAP_EXPORTER_RECORDING_FORMATS=presentation

# Metrics and health (/metrics, /healthz, /readyz).
# RECAP_EXPORTER_LISTEN_ADDR=127.0.0.1:9466
# debug, info, warn or error.
# RECAP_EXPORTER_LOG_LEVEL=info
