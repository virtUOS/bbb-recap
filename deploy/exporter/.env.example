# Settings for compose.yaml on the BBB server. Copy to .env next to it.
# The daemon's own settings are in /etc/recap-exporter/exporter.env (see exporter.env).

# The image; use the same release as the service.
EXPORTER_IMAGE=ghcr.io/virtuos/bbb-recap/recap-exporter:v0.1.0
# UID and GID of the host user recap-exporter: id -u recap-exporter; id -g recap-exporter
EXPORTER_UID=
EXPORTER_GID=
# GID of the user that runs the hook. Packaged BBB: id -g bigbluebutton. Docker BBB: 998.
HOOK_GID=
# BBB's recording dir, parent of raw/ and status/.
# Packaged BBB: /var/bigbluebutton/recording. Docker BBB: <BBB compose dir>/data/bigbluebutton/recording.
BBB_RECORDING_DIR=/var/bigbluebutton/recording
# ro, or rw to delete raw data after upload (RECAP_EXPORTER_DELETE_POLICY=after_ack or failure expiry).
RAW_MOUNT=ro
