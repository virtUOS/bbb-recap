{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:recap:schema:transcript:1",
  "title": "Transcript (recap)",
  "description": "Transcript schema v1.0.0. Normative text: docs/reference/providers.md section 5. All *_ms fields are integer milliseconds on the meeting axis (events.xml timestamp minus time_base.origin_event_ts).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "created_at",
    "source",
    "language",
    "time_base",
    "recording_periods",
    "speakers",
    "tracks",
    "segments",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "job_id": { "$ref": "#/$defs/uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "source": {
      "description": "Origin of the text. 'live-captions' is reserved for BBB 4.1 CaptionUpdatedEvent; v1 producers emit 'asr'.",
      "enum": ["asr", "live-captions"]
    },
    "language": {
      "description": "Meeting language (ISO 639-1/639-3 code) or null if unknown.",
      "oneOf": [{ "$ref": "#/$defs/language" }, { "type": "null" }]
    },
    "time_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock", "origin", "origin_event_ts", "origin_utc"],
      "properties": {
        "clock": { "const": "bbb-event-timestamp" },
        "origin": { "const": "first-recording-start" },
        "origin_event_ts": {
          "description": "events.xml 'timestamp' attribute of the first RecordStatusEvent with status true, in ms.",
          "type": "integer",
          "minimum": 0
        },
        "origin_utc": { "type": "string", "format": "date-time" }
      }
    },
    "recording_periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_ms", "end_ms", "recorded_offset_ms"],
        "properties": {
          "start_ms": { "$ref": "#/$defs/ms" },
          "end_ms": { "$ref": "#/$defs/ms" },
          "recorded_offset_ms": {
            "description": "Sum of the lengths of all earlier periods (pauses collapsed, as in BBB playback).",
            "$ref": "#/$defs/ms"
          }
        }
      }
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref"],
        "properties": {
          "ref": { "$ref": "#/$defs/speakerRef" },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 256 },
          "role": { "enum": ["moderator", "viewer"] }
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "speaker_ref", "kind", "blob_sha256", "start_ms", "end_ms", "status"],
        "properties": {
          "ref": { "$ref": "#/$defs/trackRef" },
          "speaker_ref": { "$ref": "#/$defs/speakerRef" },
          "kind": { "enum": ["microphone"] },
          "blob_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "start_ms": { "$ref": "#/$defs/ms" },
          "end_ms": { "$ref": "#/$defs/ms" },
          "status": { "enum": ["transcribed", "empty", "failed"] },
          "language": { "$ref": "#/$defs/language" },
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "dialect", "model"],
            "properties": {
              "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
              "dialect": { "type": "string", "minLength": 1, "maxLength": 64 },
              "model": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        }
      }
    },
    "segments": {
      "description": "Sorted by start_ms, then track_ref. Segments of different speakers may overlap.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "track_ref", "speaker_ref", "start_ms", "end_ms", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^seg-[0-9]{6,}$" },
          "track_ref": { "$ref": "#/$defs/trackRef" },
          "speaker_ref": { "$ref": "#/$defs/speakerRef" },
          "start_ms": { "$ref": "#/$defs/ms" },
          "end_ms": { "$ref": "#/$defs/ms" },
          "text": { "type": "string", "minLength": 1 },
          "confidence": { "$ref": "#/$defs/confidence" },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "start_ms", "end_ms"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "start_ms": { "$ref": "#/$defs/ms" },
                "end_ms": { "$ref": "#/$defs/ms" },
                "confidence": { "$ref": "#/$defs/confidence" }
              }
            }
          }
        }
      }
    },
    "gaps": {
      "description": "Spans of a track with no text because the track could not be transcribed (ASR permanent_input, retries exhausted, invalid responses exhausted, or normalize could not decode it). Recording pauses are not gaps. The job fails only if every track is a gap (docs/reference/README.md adapter error table).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["track_ref", "speaker_ref", "start_ms", "end_ms", "reason"],
        "properties": {
          "track_ref": { "$ref": "#/$defs/trackRef" },
          "speaker_ref": { "$ref": "#/$defs/speakerRef" },
          "start_ms": { "$ref": "#/$defs/ms" },
          "end_ms": { "$ref": "#/$defs/ms" },
          "reason": {
            "enum": ["asr_rejected_input", "asr_failed", "asr_invalid_response", "track_unreadable"]
          }
        }
      }
    }
  },
  "$defs": {
    "ms": { "type": "integer", "minimum": 0 },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "speakerRef": { "type": "string", "pattern": "^spk-[1-9][0-9]*$" },
    "trackRef": { "type": "string", "pattern": "^trk-[1-9][0-9]*$" }
  }
}
